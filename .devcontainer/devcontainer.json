{
  "name": "Betik — WSL Docker",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "workspace",
  "runServices": ["mongo", "mongo-init", "seed", "server", "client", "workspace"],
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  "initializeCommand": ["bash", "./dev", "init"],
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "eslint.workingDirectories": ["./Server", "./Client"],
        "files.eol": "\n"
      }
    }
  }
}
