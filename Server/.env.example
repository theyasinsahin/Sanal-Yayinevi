# Copy this file to Server/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=5000
# A local MongoDB replica set named rs0 must be running; Atlas also works.
MONGO_URI=mongodb://127.0.0.1:27017/betik_local?replicaSet=rs0
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=07575cb5e448c0b19a764f3bf4cb566d202bf5d141c897a20e164ab42cbe1f69a58ad055864e53935d0e60ea69865964
CLIENT_URL=http://localhost:3000
# Keep payments off until a separate sandbox is configured.
# Values in .env take precedence over .env.print.local.
PRINT_SYSTEM_ENABLED=true
PRINT_PAYMENTS_MODE=ENABLED
# Optional Google login; must match the frontend OAuth client ID.
GOOGLE_CLIENT_ID=620840983651-ue12o2dcdbr9o7iv0dkmhj4ed6vstno4.apps.googleusercontent.com
# Existing Gmail/Nodemailer transport; server-only secrets.
EMAIL_USER=quill1641@gmail.com
EMAIL_PASS=azvvownlcuxkxsmk
# Optional transactional SMTP provider; omitted values retain the Gmail default.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# TLS is required. Total SMTP operation deadline: 12 seconds.
# Optional additional local development origins for share previews only.
# Never used to allow arbitrary production redirects.
# SHARE_ALLOWED_WEB_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Optional: when empty, contact messages go to EMAIL_USER (not automatically published).
CONTACT_EMAIL=quill1641@gmail.com
# Optional chapter music uploads (MP3). Credentials stay on the backend.
