# iyzico test-card checkout. Keep the application's existing NODE_ENV.
PRINT_SYSTEM_ENABLED=true
PRINT_PAYMENTS_MODE=IYZICO_SANDBOX
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Generate a stable, separate 32-byte hex key; do not replace an existing key.
PRINT_ADDRESS_ENCRYPTION_KEY=
# Public backend URL for iyzico's browser callback, plus the frontend return URL.
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
# MongoDB replica set/mongos is required. Existing JWT_SECRET remains required.
# The local mock remains available with PRINT_PAYMENTS_MODE=SANDBOX,
# NODE_ENV=development/test and a 32+ character PRINT_SANDBOX_WEBHOOK_SECRET.
