# Only append to an isolated DEVELOPMENT/TEST environment. Never use a production DB.
NODE_ENV=development
PRINT_SYSTEM_ENABLED=true
PRINT_PAYMENTS_MODE=SANDBOX
# Generate separate random secrets; placeholders intentionally cannot enable payments.
PRINT_SANDBOX_WEBHOOK_SECRET=
PRINT_ADDRESS_ENCRYPTION_KEY=
# Existing MONGO_URI must reference a dedicated replica-set test database.
# Existing JWT_SECRET and CLIENT_URL remain required by the application.
