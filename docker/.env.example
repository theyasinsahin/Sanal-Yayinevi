# ./dev init creates .env.local with independent random development keys.
# Never copy Server/.env, Client/.env or production configuration here.
JWT_SECRET=
PRINT_SANDBOX_WEBHOOK_SECRET=
PRINT_ADDRESS_ENCRYPTION_KEY=
DEV_SEED_PASSWORD=

# Enable external services only after explicitly configuring their identifiers.
DEV_EXTERNAL_INTEGRATIONS=false
EMAIL_USER=
EMAIL_PASS=
CONTACT_EMAIL=
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Chapter music uses server-side signed uploads, not the unsigned image preset.
# Never prefix these credentials with REACT_APP_.
CHAPTER_MUSIC_ENABLED=true
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
